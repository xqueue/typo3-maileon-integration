{
	"name": "xqueue/typo3-maileon-integration",
	"type": "typo3-cms-extension",
	"description": "The Official TYPO3 Maileon integration Package",
	"license": "GPL-3.0-or-later",
    "authors": [
        {
            "name": "XQueue GmbH",
            "homepage": "https://xqueue.com",
            "role": "Manufacturer"
        }
    ],
	"require": {
		"php": "^8.1",
		"ext-simplexml": "*",
		"typo3/cms-core": "^12.4 || ^13.4 || ^14.3",
		"typo3/cms-form": "^12.4 || ^13.4 || ^14.3"
	},
	"require-dev": {
		"typo3/testing-framework": "^8.0 || ^9.0",
		"phpstan/phpstan": "^2.1",
		"saschaegerer/phpstan-typo3": "^3.1",
		"typo3/coding-standards": "^0.9"
	},
	"extra": {
		"typo3/cms": {
			"extension-key": "typo3_maileon_integration"
		}
	},
	"autoload": {
		"psr-4": {
			"XQueue\\Typo3MaileonIntegration\\": "Classes"
		}
	},
	"config": {
        "allow-plugins": {
            "typo3/class-alias-loader": true,
            "typo3/cms-composer-installers": true
        }
    },
	"scripts": {
		"post-install-cmd": [
			"@php vendor/bin/typo3 extension:setup"
		],
		"test-unit": "phpunit -c Tests/Unit/phpunit.xml.dist",
		"test-functional": "phpunit -c Tests/Functional/phpunit.xml.dist",
		"lint-stan": "phpstan analyse -c phpstan.neon",
		"lint-cs": "php-cs-fixer fix --dry-run --diff"
	}
}
